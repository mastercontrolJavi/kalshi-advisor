KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=./keys/kalshi.pem
DASHBOARD_USER=advisor
DASHBOARD_PASSWORD=replace-with-a-random-password
# off = no password for requests made on this PC (localhost); remote access such as Tailscale still needs it.
DASHBOARD_AUTH=on
PORT=3000
ENGINE_PORT=3001
MARKETS_PORT=3002
SESSION_TIMEZONE=America/Los_Angeles
ENABLE_EXECUTOR=false
