KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=./keys/kalshi.pem
DASHBOARD_USER=advisor
DASHBOARD_PASSWORD=replace-with-a-random-password
# off = no password for requests made on this PC (localhost); remote access such as Tailscale still needs it.
DASHBOARD_AUTH=on
PORT=3000
ENGINE_PORT=3001
SESSION_TIMEZONE=America/Los_Angeles
ENABLE_EXECUTOR=false
# Research only: record Coinbase BTC-USD order flow (L2 book, trades). Off by default: it slowed the engine (DECISIONS 65).
RECORD_ORDER_FLOW=off
# Order flow & futures pulse (DECISIONS 71): Coinbase spot + Binance/Bybit perp trades on a worker thread, 250 ms bars in
# data/flow.db (FLOW_DB overrides the path). On by default; FLOW_PULSE=off turns it off.
FLOW_PULSE=on
# Edge layer sidecar (edge/, EDGE_README.md, DECISIONS 75): Python stdlib, 127.0.0.1:EDGE_PORT; started by npm run launch.
EDGE_PORT=3003
# Set by hand only after `python -m edge.score` prints ENGINE: ADDS SIGNAL. Until then decisions use p_base.
ENGINE_VALIDATED=false
# shadow = paper fills at the next ask; live = decisions only (real fills come from Kalshi).
EDGE_MODE=shadow
# Bankroll for sizing; empty = the Kalshi account value. A notional value (e.g. 1000) lets shadow mode size paper fills.
EDGE_BANKROLL=
# EDGE_PYTHON=python   # interpreter for the sidecar if `python` is not right
# Paper-trading bot (bot/, bot/README.md, DECISIONS 81): started by npm run launch; BOT=off skips it. Any BOT_<NAME>
# overrides a setting in bot/config.py, e.g. BOT_LATENCY_MS=300, BOT_START_BANKROLL=15.
BOT=on
