{
  "name": "kalshi-advisor",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:all": "concurrently -k \"tsx watch src/engine/index.ts\" \"tsx watch src/markets/index.ts\" \"tsx scripts/web.ts --dev\"",
    "markets": "tsx src/markets/index.ts",
    "markets-backfill": "tsx scripts/markets-backfill.ts",
    "engine": "tsx src/engine/index.ts",
    "build": "next build",
    "trade": "node scripts/trade.mjs",
    "launch": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/launch.ps1",
    "shortcut": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-shortcut.ps1",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "npm run test && npm run typecheck",
    "backtest": "tsx scripts/backtest.ts"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.3",
    "better-sqlite3": "^12.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "gsap": "^3.13.0",
    "lightweight-charts": "5.2.1",
    "lucide-react": "^0.468.0",
    "next": "^15.5.9",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^3.3.0",
    "tailwind-merge": "^3.3.1",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "type": "module",
  "overrides": {
    "postcss": "^8.5.29",
    "shell-quote": "^1.12.0"
  }
}
